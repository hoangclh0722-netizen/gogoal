rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function userDoc(uid) { return get(/databases/$(db)/documents/users/$(uid)).data; }
    function notBanned() { return signedIn() && userDoc(me()).banned != true; }
    function isAdmin() { return signedIn() && userDoc(me()).role == 'admin'; }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function sportOk(s) { return s in ['football', 'badminton', 'basketball', 'pickleball', 'tennis']; }
    function perPerson(m) { return math.ceil(m.costTotal / m.playersTotal / 1000.0) * 1000; }

    function levelOk(s, key) { return !(key in s) || s[key] in [1, 2, 3, 4]; }
    function sportsOk(s) {
      return s is map
        && s.keys().hasOnly(['football', 'badminton', 'basketball', 'pickleball', 'tennis'])
        && levelOk(s, 'football') && levelOk(s, 'badminton') && levelOk(s, 'basketball')
        && levelOk(s, 'pickleball') && levelOk(s, 'tennis');
    }
    function profileOk(u) {
      return u.displayName is string && u.displayName.size() >= 2 && u.displayName.size() <= 40
        && u.district is string && u.district.size() > 0
        && sportsOk(u.sports)
        && (u.profileCompleted != true || u.sports.size() >= 1);
    }

    // Chỉ tăng đúng 1 ở một trường thống kê
    function statInc(key) {
      return request.resource.data.stats.diff(resource.data.stats).affectedKeys().hasOnly([key])
        && request.resource.data.stats[key] == resource.data.stats.get(key, 0) + 1;
    }

    // Điểm danh (UC14): chủ kèo cộng 1 trận / 1 lần vắng cho người trong kèo [m] trong cùng batch ghi attendanceTakenAt
    function attendanceStat(uid, m) {
      let before = get(/databases/$(db)/documents/matches/$(m)).data;
      let p = /databases/$(db)/documents/matches/$(m)/participants/$(uid);
      return before.hostId == me()
        && before.get('attendanceTakenAt', null) == null
        && getAfter(/databases/$(db)/documents/matches/$(m)).data.attendanceTakenAt != null
        && (uid == before.hostId
          ? statInc('matchesPlayed')
          : (get(p).data.status == 'approved' && get(p).data.attended == null
            && (getAfter(p).data.attended == true ? statInc('matchesPlayed') : statInc('noShows'))));
    }

    // Có mặt trong kèo [m]: chủ kèo, hoặc thành viên được điểm danh có mặt
    function presentIn(m, uid) {
      return get(/databases/$(db)/documents/matches/$(m)).data.hostId == uid
        || (exists(/databases/$(db)/documents/matches/$(m)/participants/$(uid))
          && get(/databases/$(db)/documents/matches/$(m)/participants/$(uid)).data.get('attended', null) == true);
    }

    // Đánh giá (UC15): người chấm cộng sao cho người được chấm trong cùng batch tạo ratings/[rid]
    function ratingStat(uid, rid) {
      let r = getAfter(/databases/$(db)/documents/ratings/$(rid)).data;
      return !exists(/databases/$(db)/documents/ratings/$(rid))
        && r.fromUid == me() && r.toUid == uid
        && request.resource.data.stats.diff(resource.data.stats).affectedKeys().hasOnly(['ratingSum', 'ratingCount'])
        && request.resource.data.stats.ratingCount == resource.data.stats.get('ratingCount', 0) + 1
        && request.resource.data.stats.ratingSum == resource.data.stats.get('ratingSum', 0) + r.stars;
    }

    function joinShapeOk(p) {
      return p.keys().hasOnly(['uid', 'matchId', 'matchStartAt', 'displayName', 'avatarUrl', 'level', 'status',
                               'message', 'paid', 'paidConfirmed', 'attended', 'requestedAt', 'updatedAt'])
        && p.displayName == userDoc(me()).displayName
        && (p.message == null || (p.message is string && p.message.size() <= 200))
        && p.paid == false && p.paidConfirmed == false && p.attended == null
        && p.requestedAt == request.time;
    }

    // Thông tin kèo dùng chung cho lúc tạo và lúc chủ kèo sửa (BR01, BR02, BR12)
    function matchShapeOk(m) {
      return m.title is string && m.title.size() >= 1 && m.title.size() <= 60
        && m.approvalMode in ['manual', 'auto']
        && m.playersTotal is int && m.playersTotal >= 2 && m.playersTotal <= 40
        && m.slotsNeeded is int && m.slotsNeeded >= 1 && m.slotsNeeded <= m.playersTotal
        && m.slotsMin is int && m.slotsMin >= 1 && m.slotsMin <= m.slotsNeeded
        && m.levelMin is int && m.levelMin >= 1 && m.levelMax is int && m.levelMax <= 4 && m.levelMin <= m.levelMax
        && m.levels.size() == m.levelMax - m.levelMin + 1
        && m.startAt is timestamp && m.endAt is timestamp
        && m.startAt >= request.time + duration.value(30, 'm')
        && m.startAt <= request.time + duration.value(30, 'd')
        && m.endAt >= m.startAt + duration.value(30, 'm')
        && m.endAt <= m.startAt + duration.value(4, 'h')
        // Hạn chốt người: trước giờ đá ít nhất 30 phút; kèo đá sau hơn 6 giờ nữa thì bắt buộc có hạn
        && (m.joinDeadline == null
          ? m.startAt <= request.time + duration.value(6, 'h')
          : m.joinDeadline is timestamp && m.joinDeadline <= m.startAt - duration.value(30, 'm'))
        && m.costTotal is int && m.costTotal >= 0
        && m.costPerPerson == perPerson(m)
        && m.district == m.venue.district
        && (m.note == null || m.note.size() <= 500);
    }

    // Đánh giá người chơi (BR10): trong 48 giờ sau giờ kết thúc, đã điểm danh, người chấm và người được chấm đều có mặt,
    // mỗi người chấm mỗi người một lần mỗi kèo (id cố định), không sửa không xóa
    match /ratings/{ratingId} {
      allow read: if signedIn();
      allow create: if notBanned()
        && request.resource.data.keys().hasOnly(['matchId', 'fromUid', 'toUid', 'stars', 'tags', 'createdAt'])
        && request.resource.data.fromUid == me()
        && request.resource.data.toUid != me()
        && ratingId == request.resource.data.matchId + '_' + me() + '_' + request.resource.data.toUid
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 4
        && request.resource.data.tags.hasOnly(['on_time', 'fair_play', 'friendly', 'skilled'])
        && request.resource.data.createdAt == request.time
        && get(/databases/$(db)/documents/matches/$(request.resource.data.matchId)).data.status == 'active'
        && get(/databases/$(db)/documents/matches/$(request.resource.data.matchId)).data.get('attendanceTakenAt', null) != null
        && request.time > get(/databases/$(db)/documents/matches/$(request.resource.data.matchId)).data.endAt
        && request.time < get(/databases/$(db)/documents/matches/$(request.resource.data.matchId)).data.endAt + duration.value(48, 'h')
        && presentIn(request.resource.data.matchId, me())
        && presentIn(request.resource.data.matchId, request.resource.data.toUid);
      allow update, delete: if false;
    }

    // Sân người dùng tự thêm: đúng khuôn, nằm trong Việt Nam, chưa xác nhận
    function venueOk(v) {
      return v.keys().hasOnly(['name', 'address', 'district', 'sportIds', 'geo', 'createdBy', 'verified', 'createdAt'])
        && v.name is string && v.name.size() >= 2 && v.name.size() <= 60
        && v.address is string && v.address.size() >= 1 && v.address.size() <= 120
        && v.district is string && v.district.size() >= 1 && v.district.size() <= 30
        && v.sportIds is list && v.sportIds.size() >= 1
        && v.sportIds.hasOnly(['football', 'badminton', 'basketball', 'pickleball', 'tennis'])
        && v.geo.keys().hasOnly(['geohash', 'geopoint'])
        && v.geo.geohash is string && v.geo.geohash.size() == 9
        && v.geo.geopoint is latlng
        && v.geo.geopoint.latitude() >= 8 && v.geo.geopoint.latitude() <= 24
        && v.geo.geopoint.longitude() >= 102 && v.geo.geopoint.longitude() <= 110
        && v.createdBy == me() && v.verified == false && v.createdAt == request.time;
    }

    match /venues/{venueId} {
      allow read: if true;
      allow create: if isAdmin()
        || (notBanned() && userDoc(me()).profileCompleted == true && venueOk(request.resource.data));
      allow update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if signedIn() && uid == me()
        && request.resource.data.role == 'user'
        && request.resource.data.banned == false
        && request.resource.data.stats.ratingCount == 0
        && request.resource.data.stats.ratingSum == 0
        && request.resource.data.stats.noShows == 0
        && request.resource.data.stats.lateLeaves == 0
        && request.resource.data.stats.lateCancels == 0
        && profileOk(request.resource.data);

      allow update: if signedIn() && uid == me() && userDoc(me()).banned != true
        && changedOnly(['displayName', 'avatarUrl', 'district', 'bio', 'sports', 'profileCompleted', 'updatedAt'])
        && profileOk(request.resource.data);
      allow update: if isAdmin() && changedOnly(['banned', 'updatedAt']);
      allow update: if notBanned() && uid != me()
        && changedOnly(['stats', 'statsRating', 'updatedAt'])
        && request.resource.data.statsRating is string
        && ratingStat(uid, request.resource.data.statsRating);
      allow update: if signedIn()
        && changedOnly(['stats', 'statsMatch', 'updatedAt'])
        && request.resource.data.statsMatch is string
        && attendanceStat(uid, request.resource.data.statsMatch);

      match /private/{doc} {
        allow read, write: if signedIn() && uid == me();
      }

      // Kèo đang theo dõi: không chiếm chỗ, chỉ chính chủ thấy
      match /watching/{matchId} {
        allow read, delete: if signedIn() && uid == me();
        allow create: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['matchId', 'matchStartAt', 'createdAt'])
          && request.resource.data.matchId == matchId
          && request.resource.data.matchStartAt is timestamp
          && request.resource.data.createdAt == request.time;
      }

      match /notifications/{id} {
        allow read, delete: if signedIn() && uid == me();
        allow update: if signedIn() && uid == me() && changedOnly(['read']);
        allow create: if notBanned() && uid != me()
          && request.resource.data.keys().hasOnly(['type', 'matchId', 'matchTitle', 'actorId', 'actorName', 'read', 'createdAt'])
          && request.resource.data.type in ['join_requested', 'member_joined', 'join_approved', 'join_rejected', 'removed',
                                            'member_left', 'match_cancelled', 'match_updated', 'match_locked']
          && request.resource.data.actorId == me()
          && request.resource.data.actorName is string && request.resource.data.actorName.size() <= 40
          && request.resource.data.matchTitle is string && request.resource.data.matchTitle.size() <= 60
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time;
      }
    }

    // "Kèo của tôi": truy vấn collection group phải tự lọc where uid == mình
    match /{path=**}/participants/{uid} {
      allow read: if signedIn() && resource.data.uid == me();
    }

    match /matches/{matchId} {
      // Rules không phải bộ lọc: truy vấn phải tự có where status == 'active' (hoặc hostId == me)
      allow read: if resource.data.status != 'hidden'
        || (signedIn() && resource.data.hostId == me()) || isAdmin();

      allow create: if notBanned()
        && request.resource.data.hostId == me()
        && request.resource.data.status == 'active'
        && request.resource.data.slotsFilled == 0
        && request.resource.data.isFull == false
        && request.resource.data.locked == false
        && sportOk(request.resource.data.sportId)
        && request.resource.data.host.displayName == userDoc(me()).displayName
        && (request.resource.data.joinDeadline == null || request.resource.data.joinDeadline > request.time)
        && matchShapeOk(request.resource.data);

      // Chủ kèo sửa hoặc hủy kèo chưa bắt đầu; không đụng tới slotsFilled
      allow update: if notBanned() && resource.data.hostId == me()
        && resource.data.status == 'active'
        && resource.data.startAt > request.time
        && changedOnly(['title', 'format', 'playersTotal', 'slotsNeeded', 'isFull', 'levelMin', 'levelMax', 'levels',
                        'startAt', 'endAt', 'venue', 'geo', 'district', 'costTotal', 'costPerPerson',
                        'approvalMode', 'minReputation', 'note', 'status', 'cancelReason', 'updatedAt',
                        'slotsMin', 'joinDeadline'])
        && request.resource.data.status in ['active', 'cancelled']
        && request.resource.data.slotsNeeded >= resource.data.slotsFilled
        && request.resource.data.isFull == (resource.data.slotsFilled >= request.resource.data.slotsNeeded)
        && ((request.resource.data.status == 'cancelled'
              && changedOnly(['status', 'cancelReason', 'updatedAt'])
              && request.resource.data.cancelReason is string
              && request.resource.data.cancelReason.size() >= 1
              && request.resource.data.cancelReason.size() <= 100)
          || (request.resource.data.status == 'active' && matchShapeOk(request.resource.data)
            // Hạn đã qua thì giữ nguyên hoặc lùi sang tương lai, không đặt hạn mới trong quá khứ
            && (request.resource.data.joinDeadline == resource.data.get('joinDeadline', null)
              || request.resource.data.joinDeadline == null
              || request.resource.data.joinDeadline > request.time)));

      // Chủ kèo chốt kèo (không nhận thêm người) hoặc mở lại
      allow update: if notBanned() && resource.data.hostId == me()
        && resource.data.status == 'active'
        && resource.data.startAt > request.time
        && changedOnly(['locked', 'updatedAt'])
        && request.resource.data.locked is bool;

      // Người chơi tự vào kèo tự động: tăng slotsFilled đúng 1, kèm participant approved của chính mình trong cùng batch
      allow update: if notBanned()
        && resource.data.hostId != me()
        && resource.data.approvalMode == 'auto'
        && resource.data.status == 'active'
        && resource.data.startAt > request.time
        && resource.data.isFull == false
        && resource.data.get('locked', false) == false
        && (resource.data.get('joinDeadline', null) == null || request.time < resource.data.joinDeadline)
        && changedOnly(['slotsFilled', 'isFull', 'updatedAt'])
        && request.resource.data.slotsFilled == resource.data.slotsFilled + 1
        && request.resource.data.slotsFilled <= resource.data.slotsNeeded
        && request.resource.data.isFull == (request.resource.data.slotsFilled >= resource.data.slotsNeeded)
        && !exists(/databases/$(db)/documents/matches/$(matchId)/participants/$(me()))
        && getAfter(/databases/$(db)/documents/matches/$(matchId)/participants/$(me())).data.status == 'approved';

      // Thành viên rời kèo: trả lại đúng 1 chỗ, kèm participant của chính mình chuyển sang left trong cùng batch
      allow update: if signedIn()
        && resource.data.status == 'active'
        && resource.data.startAt > request.time
        && changedOnly(['slotsFilled', 'isFull', 'updatedAt'])
        && request.resource.data.slotsFilled == resource.data.slotsFilled - 1
        && request.resource.data.isFull == false
        && get(/databases/$(db)/documents/matches/$(matchId)/participants/$(me())).data.status == 'approved'
        && getAfter(/databases/$(db)/documents/matches/$(matchId)/participants/$(me())).data.status == 'left';

      // Chủ kèo nhận người: tăng đúng 1 chỗ, changedMember chỉ ra participant vừa chuyển pending → approved
      allow update: if notBanned() && resource.data.hostId == me()
        && resource.data.status == 'active'
        && resource.data.get('locked', false) == false
        && resource.data.startAt > request.time
        && changedOnly(['slotsFilled', 'isFull', 'changedMember', 'updatedAt'])
        && request.resource.data.slotsFilled == resource.data.slotsFilled + 1
        && request.resource.data.slotsFilled <= resource.data.slotsNeeded
        && request.resource.data.isFull == (request.resource.data.slotsFilled >= resource.data.slotsNeeded)
        && get(/databases/$(db)/documents/matches/$(matchId)/participants/$(request.resource.data.changedMember)).data.status == 'pending'
        && getAfter(/databases/$(db)/documents/matches/$(matchId)/participants/$(request.resource.data.changedMember)).data.status == 'approved';

      // Chủ kèo mời một thành viên ra: trả lại đúng 1 chỗ, changedMember chuyển approved → removed
      allow update: if notBanned() && resource.data.hostId == me()
        && resource.data.status == 'active'
        && resource.data.startAt > request.time
        && changedOnly(['slotsFilled', 'isFull', 'changedMember', 'updatedAt'])
        && request.resource.data.slotsFilled == resource.data.slotsFilled - 1
        && request.resource.data.isFull == false
        && get(/databases/$(db)/documents/matches/$(matchId)/participants/$(request.resource.data.changedMember)).data.status == 'approved'
        && getAfter(/databases/$(db)/documents/matches/$(matchId)/participants/$(request.resource.data.changedMember)).data.status == 'removed';

      // Chủ kèo điểm danh một lần, trong 24 giờ sau giờ kết thúc (BR09)
      allow update: if notBanned() && resource.data.hostId == me()
        && resource.data.status == 'active'
        && request.time > resource.data.endAt
        && request.time < resource.data.endAt + duration.value(24, 'h')
        && resource.data.get('attendanceTakenAt', null) == null
        && changedOnly(['attendanceTakenAt', 'updatedAt'])
        && request.resource.data.attendanceTakenAt == request.time;

      allow update: if isAdmin() && changedOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['active', 'hidden', 'cancelled'];

      allow delete: if false;

      match /participants/{uid} {
        // Chỉ người trong kèo (chủ kèo, thành viên đã được nhận) xem được danh sách; ai cũng xem được yêu cầu của chính mình
        allow read: if signedIn() && (uid == me()
          || get(/databases/$(db)/documents/matches/$(matchId)).data.hostId == me()
          || (exists(/databases/$(db)/documents/matches/$(matchId)/participants/$(me()))
            && get(/databases/$(db)/documents/matches/$(matchId)/participants/$(me())).data.status == 'approved'));

        // Xin vào kèo (BR03, BR04, BR06, BR13). Duyệt và loại thành viên sẽ làm ở task sau.
        allow create: if notBanned() && uid == me()
          && request.resource.data.uid == me()
          && request.resource.data.matchId == matchId
          && joinShapeOk(request.resource.data)
          && get(/databases/$(db)/documents/matches/$(matchId)).data.hostId != me()
          && get(/databases/$(db)/documents/matches/$(matchId)).data.status == 'active'
          && get(/databases/$(db)/documents/matches/$(matchId)).data.startAt > request.time
          && get(/databases/$(db)/documents/matches/$(matchId)).data.isFull == false
          && get(/databases/$(db)/documents/matches/$(matchId)).data.get('locked', false) == false
          && (get(/databases/$(db)/documents/matches/$(matchId)).data.get('joinDeadline', null) == null
            || request.time < get(/databases/$(db)/documents/matches/$(matchId)).data.joinDeadline)
          && request.resource.data.level == userDoc(me()).sports[get(/databases/$(db)/documents/matches/$(matchId)).data.sportId]
          && request.resource.data.level in get(/databases/$(db)/documents/matches/$(matchId)).data.levels
          && (
            (get(/databases/$(db)/documents/matches/$(matchId)).data.approvalMode == 'manual'
              && request.resource.data.status == 'pending')
            || (get(/databases/$(db)/documents/matches/$(matchId)).data.approvalMode == 'auto'
              && request.resource.data.status == 'approved'
              && getAfter(/databases/$(db)/documents/matches/$(matchId)).data.slotsFilled
                 == get(/databases/$(db)/documents/matches/$(matchId)).data.slotsFilled + 1)
          );

        // Hủy yêu cầu đang chờ, hoặc rời kèo đã được nhận (phải trả lại chỗ). Phạt rời muộn (BR07) để giai đoạn 2.
        allow update: if signedIn() && uid == me()
          && get(/databases/$(db)/documents/matches/$(matchId)).data.status == 'active'
          && get(/databases/$(db)/documents/matches/$(matchId)).data.startAt > request.time
          && changedOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'left'
          && (resource.data.status == 'pending'
            || (resource.data.status == 'approved'
              && getAfter(/databases/$(db)/documents/matches/$(matchId)).data.slotsFilled
                 == get(/databases/$(db)/documents/matches/$(matchId)).data.slotsFilled - 1));

        // Điểm danh: thành viên đã được nhận đổi attended một lần, cùng batch với attendanceTakenAt của kèo
        allow update: if signedIn()
          && get(/databases/$(db)/documents/matches/$(matchId)).data.hostId == me()
          && resource.data.status == 'approved' && resource.data.attended == null
          && changedOnly(['attended', 'updatedAt'])
          && request.resource.data.attended is bool
          && get(/databases/$(db)/documents/matches/$(matchId)).data.get('attendanceTakenAt', null) == null
          && getAfter(/databases/$(db)/documents/matches/$(matchId)).data.attendanceTakenAt != null;

        // Chủ kèo từ chối hoặc nhận yêu cầu đang chờ, mời thành viên ra (UC07); nhận/mời ra phải đổi số chỗ cùng batch
        allow update: if notBanned()
          && get(/databases/$(db)/documents/matches/$(matchId)).data.hostId == me()
          && get(/databases/$(db)/documents/matches/$(matchId)).data.status == 'active'
          && get(/databases/$(db)/documents/matches/$(matchId)).data.startAt > request.time
          && changedOnly(['status', 'updatedAt'])
          && ((resource.data.status == 'pending' && request.resource.data.status == 'rejected')
            || (resource.data.status == 'pending' && request.resource.data.status == 'approved'
              && getAfter(/databases/$(db)/documents/matches/$(matchId)).data.slotsFilled
                 == get(/databases/$(db)/documents/matches/$(matchId)).data.slotsFilled + 1)
            || (resource.data.status == 'approved' && request.resource.data.status == 'removed'
              && getAfter(/databases/$(db)/documents/matches/$(matchId)).data.slotsFilled
                 == get(/databases/$(db)/documents/matches/$(matchId)).data.slotsFilled - 1));
      }

      // Chat trong kèo (UC13): chỉ chủ kèo và thành viên đã được nhận; mở tới 24 giờ sau giờ kết thúc
      match /messages/{messageId} {
        function inMatch() {
          return get(/databases/$(db)/documents/matches/$(matchId)).data.hostId == me()
            || (exists(/databases/$(db)/documents/matches/$(matchId)/participants/$(me()))
              && get(/databases/$(db)/documents/matches/$(matchId)/participants/$(me())).data.status == 'approved');
        }
        allow read: if signedIn() && inMatch();
        allow create: if notBanned() && inMatch()
          && request.time < get(/databases/$(db)/documents/matches/$(matchId)).data.endAt + duration.value(24, 'h')
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
          && request.resource.data.senderId == me()
          && request.resource.data.senderName == userDoc(me()).displayName
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /private/payment {
        allow read: if signedIn() && (
          get(/databases/$(db)/documents/matches/$(matchId)).data.hostId == me()
          || get(/databases/$(db)/documents/matches/$(matchId)/participants/$(me())).data.status == 'approved');
        allow write: if signedIn()
          && getAfter(/databases/$(db)/documents/matches/$(matchId)).data.hostId == me();
      }
    }
  }
}
